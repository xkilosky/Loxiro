# Optional, SERVER ONLY. Never prefix with VITE_, commit keys, or paste them into chat.
# Keyless sources work without this file. Free-tier web sources require your own free account.
TAVILY_API_KEY=
SERPAPI_API_KEY=
ZENSERP_API_KEY=
# Optional free OpenAlex key increases its budget (basic queries also work without a key).
OPENALEX_API_KEY=
# Optional real contact email for provider identification; do not invent one.
PROVIDER_CONTACT_EMAIL=
# Paid/trial/overage-capable legacy providers are disabled unless explicitly opted in.
# The pre-rename LOXIRO_ALLOW_PAID_PROVIDERS is still honored, so an existing
# Vercel variable keeps working; VEILIX_ takes precedence when both are set.
VEILIX_ALLOW_PAID_PROVIDERS=0
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
