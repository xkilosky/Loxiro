# Copy to android/keystore.properties and fill in the real values. This file is
# gitignored; the example is committed so the format is discoverable.
#
# Generate the keystore once and keep it safe. Losing it means you can never
# update installed users again:
#
#   cd android
#   keytool -genkeypair -v -keystore veilix-release.jks \
#     -alias veilix -keyalg RSA -keysize 4096 -validity 10000
#
# With this file absent, the release build is left unsigned rather than failing.
# In CI the same four values come from the ANDROID_KEYSTORE_BASE64,
# ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS and ANDROID_KEY_PASSWORD secrets.
storeFile=veilix-release.jks
storePassword=change-me
keyAlias=veilix
keyPassword=change-me
